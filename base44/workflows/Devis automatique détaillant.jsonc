{
  "name": "Devis automatique d\u00e9taillant",
  "description": "Cr\u00e9e automatiquement un devis et l'envoie par email au d\u00e9taillant quand une nouvelle commande est pass\u00e9e",
  "trigger": {
    "condition": "${ (.trigger.data.client_type == \"detaillant\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Order"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "devis_automatique_d_taillant",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onOrderCreatedDevis",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "onOrderCreatedDevis"
  }
}